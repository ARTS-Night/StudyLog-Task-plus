{
  "manifest_version": 3,
  "name": "スタログ授業メモ",
  "version": "1.0.0",
  "description": "data-class-id を持つ授業セクションごとにメモを保存します。",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
