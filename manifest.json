{
  "manifest_version": 3,
  "key": "",
  "name": "スタログ授業メモ",
  "version": "0.2.2",
  "version_name": "0.2.2 beta",
  "description": "スタログの授業ごとにタスクを保存し、年度別の専用画面で管理します。",
  "permissions": [
    "storage",
    "identity",
    "alarms"
  ],
  "host_permissions": [
    "https://portal.iwasaki.ac.jp/*"
  ],
  "oauth2": {
    "client_id": "279232239122-maj8ovasoptlgevm9q7o3f7rs3m8f6q5.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/drive.file",
      "https://www.googleapis.com/auth/tasks",
      "https://www.googleapis.com/auth/userinfo.email"
    ]
  },
  "action": {
    "default_popup": "src/ui/popup.html",
    "default_title": "すべてのタスクを表示"
  },
  "options_ui": {
    "page": "src/ui/settings.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "src/core/mutation-lock-background.js"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "src/ui/settings.html",
        "src/ui/tasks.html"
      ],
      "matches": [
        "https://portal.iwasaki.ac.jp/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://portal.iwasaki.ac.jp/lms/*"
      ],
      "js": [
        "src/lms/class-catalog.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://portal.iwasaki.ac.jp/lms/*"
      ],
      "js": [
        "src/core/sync-guard.js",
        "src/core/mutation-lock.js",
        "src/core/task-lifecycle.js",
        "src/core/local-task-store.js",
        "src/lms/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://portal.iwasaki.ac.jp/portal/lmsinc/sMyPage.php*",
        "https://portal.iwasaki.ac.jp/portal/lmsinc/tMyPage.php*"
      ],
      "js": [
        "src/lms/class-catalog.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
