{
  "manifest_version": 3,
  "key": "",
  "name": "スタログ授業メモ",
  "version": "1.2.0",
  "description": "スタログの授業ごとにタスクを保存し、年度別の専用画面で管理します。",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "すべてのタスクを表示"
  },
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": [
        "settings.html",
        "tasks.html"
      ],
      "matches": [
        "https://portal.iwasaki.ac.jp/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://portal.iwasaki.ac.jp/lms/*"
      ],
      "js": [
        "class-catalog.js",
        "sync-guard.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://portal.iwasaki.ac.jp/portal/lmsinc/sMyPage.php*"
      ],
      "js": [
        "class-catalog.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
